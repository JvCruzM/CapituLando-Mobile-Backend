  "item": [
    {
      "name": "01 — Login e variáveis",
      "item": [
        {
          "name": "01 — Entrar e iniciar demonstração",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('runTag',Date.now().toString(36));for(const key of ['videoStoryId','videoRaceId','videoOrganizationId','videoCharacterId','videoTargetCharacterId','videoRelationshipId','videoOrganizationLinkId'])pm.environment.unset(key);",
                  "for(const key of [\"email\",\"password\"]){if(pm.variables.get(key)===undefined||pm.variables.get(key)===null||pm.variables.get(key)===''){throw new Error('Preencha a variável '+key+' ou execute primeiro a requisição que a define.');}}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',function(){const expected=[200];if(!expected.includes(pm.response.code))throw new Error('Esperado '+expected.join('/')+', recebido '+pm.response.code);});",
                  "",
                  "if(pm.response.code===200){const data=pm.response.json();",
                  "pm.environment.set(\"accessToken\",data.accessToken);",
                  "pm.environment.set(\"refreshToken\",data.refreshToken);",
                  "pm.environment.set(\"sessionId\",data.sessionId);",
                  "pm.environment.set(\"userRole\",data.user.role);",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "description": ""
    },
